{
  "name": "playwright-ai-agents",
  "version": "1.0.0",
  "description": "TTACart end-to-end suite, planned and written by the Playwright planner, generator and healer agents",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed --reporter=list",
    "test:smoke": "playwright test --grep @p0 --reporter=list",
    "test:bugs": "playwright test src/tests/checkout/checkout-known-bugs.spec.ts --reporter=list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "dotenv": "^18.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
