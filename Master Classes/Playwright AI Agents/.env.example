# Copy to .env and fill in. .env is gitignored and must stay that way.

BASE_URL=https://app.thetestingacademy.com/playwright/ttacart/

# NOT named USERNAME / PASSWORD, and that is not a style choice: Windows defines
# USERNAME as a system environment variable, and dotenv will not overwrite a
# variable that is already set. A bare USERNAME key here is read, ignored, and
# your Windows account name is submitted to the login form instead - with no
# warning, because dotenv considers declining to overwrite correct behaviour.
TTA_USERNAME=standard_user
TTA_PASSWORD=

# Optional.
# LOG_LEVEL=info          # debug | info | warn | error
# DEBUG=1                 # forces LOG_LEVEL=debug
# ELEMENT_TIMEOUT_MS=10000
# VISUAL_STEPS=1          # attach a screenshot to each visualStep
