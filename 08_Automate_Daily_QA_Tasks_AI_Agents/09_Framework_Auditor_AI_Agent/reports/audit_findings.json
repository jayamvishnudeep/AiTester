  "rule_reference": [
    {
      "id": "hard_sleep_java",
      "name": "Hard-coded sleep",
      "severity": "high",
      "why": "A fixed sleep is either longer than needed, which slows every run, or shorter than needed, which makes the test flaky. It cannot be both right and fast.",
      "fix": "Replace with WebDriverWait and an ExpectedCondition for the state you are waiting for."
    },
    {
      "id": "hard_sleep_ts",
      "name": "Hard-coded sleep",
      "severity": "high",
      "why": "waitForTimeout pauses for a fixed period regardless of whether the page is ready, which is the single most common source of flakiness in a Playwright suite.",
      "fix": "Use a web-first assertion or locator wait - Playwright retries until the condition holds."
    },
    {
      "id": "implicit_wait",
      "name": "Implicit wait",
      "severity": "medium",
      "why": "An implicit wait applies to every findElement in the session and interacts badly with explicit waits, producing timeouts far longer than either setting suggests.",
      "fix": "Remove it and wait explicitly where a wait is actually needed."
    },
    {
      "id": "absolute_xpath",
      "name": "Absolute XPath",
      "severity": "high",
      "why": "An absolute XPath encodes the whole document structure, so any markup change anywhere above the element breaks it.",
      "fix": "Locate by role, label, test id or a stable attribute instead."
    },
    {
      "id": "indexed_xpath",
      "name": "Index-based XPath",
      "severity": "medium",
      "why": "An XPath that selects by position breaks as soon as a sibling is added or reordered.",
      "fix": "Anchor on an attribute or accessible name rather than position."
    },
    {
      "id": "styling_css_selector",
      "name": "Selector tied to styling",
      "severity": "medium",
      "why": "A selector built from utility or styling classes breaks when the design changes, which is exactly when nobody expects the tests to break.",
      "fix": "Use a data-testid or an accessible role and name."
    },
    {
      "id": "nth_child_selector",
      "name": "Positional CSS selector",
      "severity": "medium",
      "why": "nth-child ties the selector to sibling order, so inserting an element anywhere before it silently changes what the test clicks.",
      "fix": "Select by role, label or test id."
    },
    {
      "id": "driver_in_test",
      "name": "WebDriver call in the test layer",
      "severity": "medium",
      "why": "findElement inside a test method means the locator lives in the test, so the same element is re-located in every test that touches it and one markup change edits many files.",
      "fix": "Move the locator into a page object and call a named method from the test."
    },
    {
      "id": "raw_page_call_in_test",
      "name": "Raw selector in the test layer",
      "severity": "medium",
      "why": "page.click and page.fill with a literal selector put the locator in the test, which is the thing a Page Object exists to prevent.",
      "fix": "Move the locator into a Page Object and expose a named action."
    },
    {
      "id": "assertion_in_page_object",
      "name": "Assertion inside a page object",
      "severity": "high",
      "why": "A page object that asserts decides whether a test passes, so the test no longer says what it is checking and the page object cannot be reused by a test that expects failure.",
      "fix": "Return the value and let the test assert on it."
    },
    {
      "id": "static_mutable_driver",
      "name": "Static mutable driver",
      "severity": "high",
      "why": "A static WebDriver is shared by every class in the JVM, so the suite can never run in parallel and one test's state leaks into the next.",
      "fix": "Hold the driver per test instance, or in a ThreadLocal if it must be shared."
    },
    {
      "id": "disabled_test_java",
      "name": "Disabled test",
      "severity": "medium",
      "why": "A disabled test is coverage the team believes it has and does not. They are rarely re-enabled once the reason is forgotten.",
      "fix": "Fix it, or delete it and record the gap."
    },
    {
      "id": "disabled_test_ts",
      "name": "Disabled test",
      "severity": "medium",
      "why": "A skipped test is coverage the team believes it has and does not.",
      "fix": "Fix it, or delete it and record the gap."
    },
    {
      "id": "console_output_java",
      "name": "Console output instead of logging",
      "severity": "low",
      "why": "System.out has no level, no timestamp and no destination, so it is invisible in CI and cannot be turned down.",
      "fix": "Use a logger."
    },
    {
      "id": "console_output_ts",
      "name": "Console output instead of logging",
      "severity": "low",
      "why": "console.log in a test is noise in the CI log and tells you nothing on a failure that the trace does not already show.",
      "fix": "Remove it, or attach the information to the test report."
    },
    {
      "id": "empty_catch",
      "name": "Empty catch block",
      "severity": "high",
      "why": "A swallowed exception turns a real failure into a pass. It is the only anti-pattern here that can make a broken suite look green.",
      "fix": "Handle it, log it, or let it propagate."
    },
    {
      "id": "hardcoded_credential",
      "name": "Credential in source",
      "severity": "high",
      "why": "A password committed to the repository is a password that has to be rotated when anyone leaves, and it is in the history for ever.",
      "fix": "Read it from the environment or a secret store."
    },
    {
      "id": "hardcoded_environment_url",
      "name": "Environment URL in source",
      "severity": "medium",
      "why": "A URL written into the test means the suite can only ever run against one environment.",
      "fix": "Take the base URL from configuration."
    }
  ]
}