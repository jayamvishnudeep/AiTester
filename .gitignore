target/
node_modules/
playwright-report/
test-results/
*.class
*.jar
# Root README and notes only. A bare "README.md" would match at every level and
# hide the per-project READMEs too; the leading slash pins it to the repo root.
/README.md
/Notes.md
.env
*.env
config.json
*.sqlite3
.runtime/
__pycache__/
.pytest_cache/
*.pyc

# Python virtualenvs. A venv is tens of thousands of library files and is
# rebuilt from requirements, never committed - the node_modules of Python.
.venv/
venv/
env/
ENV/

# Runtime logs. Langflow rewrites 09_LangFlow/langflow.log on every run and it
# reached 13 MB in two days, which is noise in a diff and nothing a reader needs
# a year from now. The workflow and flow exports are the artefacts worth keeping.
*.log

# Except agent 11's sample CI logs, which are fixtures rather than runtime
# output - the agent reads them, and a CI log named anything but .log would be
# a worse example of the thing it is meant to be an example of.
!08_Automate_Daily_QA_Tasks_AI_Agents/02_Langflow_Agents/11_CI_CD_Failure_Analyzer_AI_Agent/sample_logs/*.log

.idea/
*.iml
.claude/

\.DS_Store
Thumbs.db