      "parameters": {
        "jsCode": "\nconst NP = 'Not Provided';\nfunction s(v){\n  if (v === null || v === undefined) return NP;\n  const t = String(v).replace(/[\\r\\n\\t]+/g, ' ').replace(/\\s+/g, ' ').trim();\n  return t.length ? t : NP;\n}\nfunction adf(v){\n  if (!v) return NP;\n  if (typeof v === 'string') return s(v);\n  let out = '';\n  const walk = (n) => {\n    if (!n) return;\n    if (typeof n.text === 'string') out += n.text + ' ';\n    if (Array.isArray(n.content)) n.content.forEach(walk);\n  };\n  try { walk(v); } catch (e) { return NP; }\n  return s(out);\n}\n\nconst results = [];\nfor (const item of $input.all()) {\n  const b = item.json || {};\n  const issue = b.issue || b;\n  const f = issue.fields || {};\n  const key = issue.key || NP;\n\n  const self = issue.self || '';\n  let host = '';\n  if (self.indexOf('/rest/') > -1) host = self.split('/rest/')[0];\n  const jira_url = host && key !== NP ? host + '/browse/' + key : NP;\n\n  const labels = Array.isArray(f.labels) && f.labels.length ? f.labels.join(', ') : NP;\n  const components = Array.isArray(f.components) && f.components.length\n    ? f.components.map(c => c && c.name).filter(Boolean).join(', ') : NP;\n  const affected_version = Array.isArray(f.versions) && f.versions.length\n    ? f.versions.map(v => v && v.name).filter(Boolean).join(', ') : NP;\n  const fix_version = Array.isArray(f.fixVersions) && f.fixVersions.length\n    ? f.fixVersions.map(v => v && v.name).filter(Boolean).join(', ') : NP;\n\n  let linked = NP;\n  if (Array.isArray(f.issuelinks) && f.issuelinks.length) {\n    const parts = [];\n    for (const l of f.issuelinks) {\n      const rel = l && l.type ? (l.type.outward || l.type.name || 'linked') : 'linked';\n      const other = (l && l.outwardIssue && l.outwardIssue.key) || (l && l.inwardIssue && l.inwardIssue.key);\n      if (other) parts.push(rel + ' ' + other);\n    }\n    if (parts.length) linked = parts.join('; ');\n  }\n\n  let comments = NP;\n  if (f.comment && Array.isArray(f.comment.comments) && f.comment.comments.length) {\n    const parts = [];\n    for (const c of f.comment.comments) {\n      const who = (c && c.author && c.author.displayName) || 'Unknown';\n      const body = adf(c && c.body);\n      parts.push(who + ': ' + body);\n    }\n    comments = s(parts.join(' | '));\n  }\n\n  results.push({ json: {\n    jira_key: s(key),\n    jira_url: s(jira_url),\n    project: s(f.project && f.project.key),\n    summary: s(f.summary),\n    description: adf(f.description),\n    issue_type: s(f.issuetype && f.issuetype.name),\n    status: s(f.status && f.status.name),\n    priority: s(f.priority && f.priority.name),\n    severity: NP,\n    reporter: s(f.reporter && f.reporter.displayName),\n    assignee: s(f.assignee && f.assignee.displayName),\n    created_date: s(f.created),\n    updated_date: s(f.updated),\n    resolved_date: s(f.resolutiondate),\n    environment: adf(f.environment),\n    affected_version: s(affected_version),\n    fix_version: s(fix_version),\n    labels: s(labels),\n    components: s(components),\n    resolution: s(f.resolution && f.resolution.name),\n    linked_issues: s(linked),\n    comments: comments,\n  }});\n}\nreturn results;\n"
      },
