        "jsCode": "\nconst NP = 'Not Provided';\nfunction s(v){\n  if (v === null || v === undefined) return NP;\n  const t = String(v).replace(/[\\r\\n\\t]+/g, ' ').replace(/\\s+/g, ' ').trim();\n  return t.length ? t : NP;\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst norm = $('Normalize Jira Issue').first().json;\nconst raw = $input.first().json || {};\nconst ai = raw.output || raw || {};\n\nreturn [{ json: {\n  jira_key: s(norm.jira_key),\n  jira_url: s(norm.jira_url),\n  summary: s(norm.summary),\n  reporter: s(norm.reporter),\n  assignee: s(norm.assignee),\n  severity_priority: s(norm.priority),\n  environment: s(norm.environment),\n  what_happened: s(ai.what_happened),\n  impact_blast_radius: s(ai.impact_blast_radius),\n  business_impact: s(ai.business_impact),\n  date_introduced: s(ai.date_introduced),\n  date_detected: s(ai.date_detected !== undefined && ai.date_detected !== null && String(ai.date_detected).length ? ai.date_detected : norm.created_date),\n  date_resolved: s(ai.date_resolved),\n  detection_method: s(ai.detection_method),\n  why_1: s(ai.why_1),\n  why_2: s(ai.why_2),\n  why_3: s(ai.why_3),\n  why_4: s(ai.why_4),\n  why_5: s(ai.why_5),\n  technical_factors: s(ai.technical_factors),\n  process_factors: s(ai.process_factors),\n  detection_gap: s(ai.detection_gap),\n  fix_description: s(ai.fix_description),\n  fix_verification: s(ai.fix_verification),\n  process_improvement: s(ai.process_improvement),\n  suggested_owner: s(ai.suggested_owner),\n  suggested_target_date: s(ai.suggested_target_date),\n  confidence: s(ai.confidence),\n  missing_information: s(ai.missing_information),\n  rca_generated_date: today,\n}}];\n"
