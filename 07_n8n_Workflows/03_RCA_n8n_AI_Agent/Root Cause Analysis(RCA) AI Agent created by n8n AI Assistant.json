      "parameters": {
        "jsCode": "\nconst norm = $('Normalize Jira Issue').first().json;\nconst existing = $input.all().filter(i => i.json && i.json.jira_key);\nlet should_process = true;\nif (existing.length > 0) {\n  // Already RCA'd — only refresh if the ticket is now resolved/closed.\n  const st = String(norm.status || '').toLowerCase();\n  should_process = ['done', 'resolved', 'closed'].includes(st);\n}\nreturn [{ json: Object.assign({}, norm, { should_process: should_process }) }];\n"
      },
